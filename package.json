{
  "name": "rubber-duck-gate",
  "version": "0.1.0",
  "description": "A git hook that blocks risky pushes until you explain your change out loud to a rubber duck. Camera only, no microphone.",
  "license": "MIT",
  "private": true,
  "main": "app/main.js",
  "bin": {
    "duck": "bin/duck.js"
  },
  "scripts": {
    "build": "esbuild app/renderer.js --bundle --platform=browser --format=iife --outfile=app/dist/renderer.bundle.js --log-level=warning && esbuild app/preload.js --bundle --platform=node --external:electron --outfile=app/dist/preload.js --log-level=warning",
    "start": "npm run build && node bin/duck.js gate",
    "test": "node --test",
    "prepare": "npm run build",
    "test:ui": "npm run build && node scripts/ui-check.js"
  },
  "dependencies": {
    "@smartspectra/node-sdk": "^3.4.0"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "esbuild": "^0.28.2"
  },
  "repository": "https://github.com/RohanPandeydev/rubber-duck-gate"
}
